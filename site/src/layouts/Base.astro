---
/**
 * The one layout for every page on the site.
 *
 * `variant="landing"` renders the page full-bleed (the hero block supplies
 * its own markup); `variant="doc"` wraps it in an article column with a
 * breadcrumb back to the home page.
 *
 * No client-side JavaScript is emitted. Code samples are highlighted at
 * build time by Shiki, configured in astro.config.mjs.
 */
interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'he';
  variant?: 'landing' | 'doc';
  altHref: string;
  altLabel: string;
  altLang: 'en' | 'he';
}

const {
  title,
  description = "Obsidian's own renderer, running in a standard browser.",
  lang,
  variant = 'doc',
  altHref,
  altLabel,
  altLang,
} = Astro.props;

const he = lang === 'he';
const home = he ? '/he/' : '/';
const homeLabel = he ? '\u2192 \u05d7\u05d6\u05e8\u05d4 \u05dc\u05d3\u05e3 \u05d4\u05e8\u05d0\u05e9\u05d9' : '\u2190 Back to the home page';
---

<!doctype html>
<html lang={lang} dir={he ? 'rtl' : 'ltr'}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#1e1e1e" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
</head>
<body>

<a class="lang" href={altHref} hreflang={altLang} lang={altLang} dir={altLang === 'he' ? 'rtl' : 'ltr'}>{altLabel}</a>

{variant === 'landing' ? (
  <main class="wrap landing"><slot /></main>
) : (
  <article class="doc">
    <a class="crumb" href={home}>{homeLabel}</a>
    <slot />
  </article>
)}

<footer class="wrap">
  <a href={he ? '/he/install' : '/install'}>{he ? '\u05d4\u05ea\u05e7\u05e0\u05d4' : 'Install'}</a>&#183;
  <a href={he ? '/he/architecture' : '/architecture'}>{he ? '\u05d0\u05e8\u05db\u05d9\u05d8\u05e7\u05d8\u05d5\u05e8\u05d4' : 'Architecture'}</a>&#183;
  <a href="https://github.com/MusiCode1/markport">GitHub</a>&#183;
  <a href="https://obsidian.md">Obsidian</a>
  <p class="note" style="margin-top:14px">
    Markport is free software under the GPL-3.0 - that covers Markport's own code, not
    Obsidian's. Obsidian is a trademark of its owner.
  </p>
</footer>

</body>
</html>

<style is:global>
  :root {
    --bg: #1e1e1e;
    --panel: #262626;
    --line: #363636;
    --text: #dcddde;
    --dim: #999;
    --accent: #7f6df2;
    --accent-soft: #a396f5;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  a { color: var(--accent-soft); }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }

  header { padding: 72px 0 40px; text-align: center; }
  h1 { font-size: 2.6rem; line-height: 1.15; margin: 0 0 14px; letter-spacing: -0.02em; }
  h1 span { color: var(--accent-soft); }
  .tagline { font-size: 1.2rem; color: var(--dim); margin: 0 auto; max-width: 34em; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin: 36px 0 8px; }
  .btn {
    display: inline-block; padding: 13px 26px; border-radius: 8px;
    text-decoration: none; font-weight: 600; font-size: 1.02rem;
    border: 1px solid var(--line); color: var(--text); background: var(--panel);
    transition: border-color .15s, transform .15s;
  }
  .btn:hover { border-color: var(--accent); transform: translateY(-1px); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-soft); border-color: var(--accent-soft); }
  .btn small { display: block; font-weight: 400; font-size: .8rem; opacity: .8; margin-top: 2px; }

  section { padding: 30px 0; border-top: 1px solid var(--line); }
  h2 { font-size: 1.25rem; margin: 0 0 14px; }
  ul { padding-left: 1.2em; }
  li { margin: 6px 0; }
  code {
    background: var(--panel); border: 1px solid var(--line); border-radius: 4px;
    padding: 1px 5px; font-size: .88em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .note { color: var(--dim); font-size: .93rem; }
  pre {
    direction: ltr; text-align: left; overflow-x: auto;
    background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
    padding: 10px 13px; margin: 10px 0; font-size: .85rem; line-height: 1.5;
  }
  pre code { background: none; border: none; padding: 0; font-size: inherit; }
  .wordmark {
    font-size: .95rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent-soft); margin: 0 0 10px;
  }
  h3 { font-size: 1.02rem; margin: 22px 0 6px; color: var(--text); }
  h3:first-of-type { margin-top: 6px; }
  .disclaimer {
    margin: 26px auto 0; max-width: 42em; font-size: .92rem; color: var(--dim);
    border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; background: var(--panel);
  }

  table { width: 100%; border-collapse: collapse; font-size: .93rem; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); }
  th { color: var(--dim); font-weight: 600; }
  td:not(:first-child), th:not(:first-child) { text-align: center; width: 5.5em; }

  footer { padding: 34px 0 60px; color: var(--dim); font-size: .9rem; text-align: center; }
  footer a { margin: 0 8px; }

  .lang {
    position: absolute; top: 16px; inset-inline-end: 20px;
    font-size: .88rem; color: var(--dim); text-decoration: none;
    border: 1px solid var(--line); border-radius: 6px; padding: 4px 11px;
  }
  .lang:hover { color: var(--text); border-color: var(--accent); }

  @media (max-width: 520px) {
    header { padding: 48px 0 30px; }
    h1 { font-size: 2rem; }
    .btn { width: 100%; text-align: center; }
  }

  /* Landing page: sections separated by a rule, grey notes as blockquotes. */
  .landing { padding-bottom: 20px; }
  .landing h2 { font-size: 1.25rem; margin: 0 0 14px; padding-top: 30px; border-top: 1px solid var(--line); }
  .landing h3 { font-size: 1.02rem; margin: 22px 0 6px; }
  .landing > h2:first-of-type { border-top: none; }
  .landing blockquote { margin: 14px 0; padding: 0; border: none; color: var(--dim); font-size: .93rem; }
  .landing blockquote p { margin: 6px 0; }
  .landing ul { padding-inline-start: 1.2em; }
  .landing li { margin: 6px 0; }

  /* Documentation pages: an article column with a plain document rhythm. */
  .doc { max-width: 820px; margin: 0 auto; padding: 34px 20px 70px; }
  .doc h1 { font-size: 2rem; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.02em; }
  .doc h2 { font-size: 1.3rem; margin: 34px 0 12px; padding-top: 22px; border-top: 1px solid var(--line); }
  .doc h3 { font-size: 1.06rem; margin: 24px 0 8px; }
  .doc blockquote { margin: 14px 0; padding: 0 0 0 14px; border-inline-start: 3px solid var(--line); color: var(--dim); }
  .doc blockquote p { margin: 6px 0; }
  .doc table { margin: 14px 0; }
  .doc td, .doc th { text-align: start; }
  .doc td:not(:first-child), .doc th:not(:first-child) { text-align: start; width: auto; }
  .doc hr { border: none; border-top: 1px solid var(--line); margin: 26px 0; }
  .crumb { display: block; margin-bottom: 20px; font-size: .92rem; color: var(--dim); }
  .crumb a { text-decoration: none; }

  /* Shiki emits its own background; keep the panel colour of the rest of the page. */
  pre.astro-code { background: var(--panel) !important; border: 1px solid var(--line); }
  /* A Hebrew comment inside an LTR code block would otherwise be reordered
     by the bidi algorithm; plaintext gives each line its own direction. */
  pre.astro-code code { unicode-bidi: plaintext; }
</style>
