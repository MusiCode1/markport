---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('pages', 'he/landing');
const { Content } = await render(entry!);
---
<Base
  title="Markport - אובסידיאן בתוך הדפדפן"
  lang="he"
  variant="landing"
  altHref="/"
  altLabel="English"
  altLang="en"
>
  <Content />
</Base>
