{
  "name": "obsidian-web-cf",
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "description": "Cloudflare Workers deployment for obsidian-web (demo + personal use)",
  "private": true,
  "scripts": {
    "build": "bash scripts/build-assets.sh",
    "build:demo": "OW_PROFILE=demo bash scripts/build-assets.sh",
    "predeploy": "npm run build && bash scripts/guard-deploy-target.sh main",
    "deploy": "wrangler pages deploy ../../../.tmp/deployments/cloudflare/public --project-name=obsidian-online --branch=main --commit-dirty=true",
    "predeploy:demo": "npm run build:demo && bash scripts/guard-deploy-target.sh demo",
    "deploy:demo": "wrangler pages deploy ../../../.tmp/deployments/cloudflare/public --project-name=obsidian-online --branch=demo --commit-dirty=true",
    "dev": "bash scripts/build-assets.sh && wrangler pages dev ../../../.tmp/deployments/cloudflare/public",
    "test": "bun test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
